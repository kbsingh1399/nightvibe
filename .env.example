# ── NightVibe India — Environment Configuration ─────────────────────────────
# Copy to `.env` and adjust. Defaults run the platform fully out-of-the-box
# on a file-backed SQLite DB + in-memory Redis fallback.

# development | production
# In production the platform FAILS CLOSED when security primitives are missing.
ENV=development

# SQLAlchemy DSN. SQLite by default; use PostgreSQL in production:
#   postgresql+psycopg2://nightvibe:pass@host:5432/nightvibe
DATABASE_URL=sqlite:///./nightvibe.db

# Redis for the nonce-burn anti-replay cache, distributed locks & OTP store.
# Leave empty in dev to use the in-memory fallback.
REDIS_URL=

# Comma-separated CORS allow-list
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# ── JWT / Pass secrets (set strong random values in production) ─────────────
NIGHTVIBE_JWT_SECRET=nightvibe_jwt_master_secret_key_2026_prod
NIGHTVIBE_PASS_KEY=nightvibe_pass_hmac_master_secret_2026
NIGHTVIBE_DOOR_KEY=nightvibe_door_offline_verify_secret_2026

# ── Razorpay webhook ─────────────────────────────────────────────────────────
RAZORPAY_WEBHOOK_SECRET=test_webhook_secret_key_2026

# ── OTP / rate limiting ──────────────────────────────────────────────────────
OTP_TTL_SEC=300
OTP_MAX_ATTEMPTS=5
OTP_RATE_WINDOW_SEC=60
OTP_RATE_MAX_PER_WINDOW=3

# ── MSG91 (SMS OTP + WhatsApp). Empty in dev → local mock dispatch ─────────
MSG91_AUTH_KEY=
MSG91_OTP_FLOW_ID=
MSG91_SENDER_ID=NIGHTV

# ── Anti-fraud venue claim PINs (per venue) ─────────────────────────────────
VENUE_PIN_VENUE_TRILOGY=8844
VENUE_PIN_VENUE_KOKO=1122
VENUE_PIN_VENUE_BASTIAN=9933
VENUE_PIN_VENUE_RAEETH=7070
